# Application Port (Automatically provided by Railway)
PORT=3000

# Admin Access Credentials (Comma-separated list of allowed IDs/Emails and Passwords)
ADMIN_IDENTIFIERS=admin,admin@canteen.com
ADMIN_PASSWORDS=admin123

# Database Configuration
# NOTE: If you add a MySQL service on Railway, Railway automatically sets DATABASE_URL or MYSQLHOST.
# The app detects this automatically with zero manual configuration.
# If connecting manually to an external MySQL provider, provide these:
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=smart_canteen
MYSQL_SSL=false
